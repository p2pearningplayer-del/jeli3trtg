# Prevent directory listing and execution of scripts inside uploads directory
Options -Indexes -ExecCGI

# Remove any script handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .exe .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .exe .sh

# Deny direct access to all executable script extensions (Apache 2.2 and Apache 2.4 compatible)
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|sh|pl|cgi|exe|asp|aspx|jsp|jspx|py|rb|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP engine if mod_php is active
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Prevent MIME sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
